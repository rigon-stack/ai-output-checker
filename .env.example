# Copy to .env and fill in real values: cp .env.example .env

# Postgres container (used by docker-compose.yml)
POSTGRES_USER=checker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_output_checker
POSTGRES_PORT=5432

# Connection string the app uses (must match the values above)
DATABASE_URL=postgres://checker:change-me@localhost:5432/ai_output_checker

# HTTP server
PORT=3000

# OpenRouter API key used by src/checker.ts (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model used for checking; openrouter/free routes to a free model
OPENROUTER_MODEL=openrouter/free

# Max successful checks per UTC day for POST /check (default 50)
DAILY_CHECK_LIMIT=50
