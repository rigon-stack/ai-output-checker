# Copy to .env and fill in real values: cp .env.example .env

# Postgres container (used by docker-compose.yml)
POSTGRES_USER=checker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_output_checker
POSTGRES_PORT=5432

# Connection string the app uses (must match the values above)
DATABASE_URL=postgres://checker:change-me@localhost:5432/ai_output_checker

# HTTP server
PORT=3000
